{
  "name": "audio-prep-studio",
  "version": "1.0.0",
  "description": "Local desktop app for previewing audio processing and exporting 24-bit WAV files.",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "cross-env ELECTRON_RUN_AS_NODE= electron-vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "cross-env": "^10.1.0",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "electron": "^39.2.7",
    "semantic-release": "^25.0.3"
  }
}
